{
  "expo": {
    "name": "LP-MOB",
    "slug": "LP-MOB",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/logo_light.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./src/assets/logo_light.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/logo_light.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./src/assets/logo_light.png"
    },
    "plugins": [
      "expo-video",
      "expo-audio",
      "@react-native-community/datetimepicker"
    ]
  }
}
